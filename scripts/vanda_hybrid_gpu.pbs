#!/bin/bash
#PBS -P personal-nithillen.jayaseelan
#PBS -j oe
#PBS -N kmeans_hybrid_gpu
#PBS -q gpu
#PBS -l select=1:ncpus=72:mpiprocs=72:ompthreads=1:ngpus=1:mem=64gb
#PBS -l walltime=00:30:00

cd $PBS_O_WORKDIR || exit 1

# Load recommended CUDA-aware OpenMPI + NVHPC module on Vanda (Lecture 12 Slide 40)
module load nvhpc-hpcx-cuda12/26.1

mkdir -p bin results
mpicxx -O3 -std=c++17 -fopenmp src/kmeans_omp.cpp -o bin/kmeans_omp
g++ -O3 -std=c++17 -fopenmp -DSTANDALONE_OMP src/kmeans_omp.cpp -o bin/kmeans_omp_standalone
nvc++ -O3 -std=c++17 -mp=gpu -I$(dirname $(which mpicxx))/../include -L$(dirname $(which mpicxx))/../lib -lmpi src/kmeans_omp.cpp -o bin/kmeans_omp_gpu
nvcc -O3 -std=c++17 -ccbin mpicxx src/kmeans_cuda.cu -o bin/kmeans_cuda

echo "=================================================================="
echo "  1. Vanda 72-Core Node: Hybrid MPI x OpenMP + CUDA GPU Suite     "
echo "=================================================================="
python3 scripts/run_hybrid_and_gpu_benchmarks.py --vanda

echo "=================================================================="
echo "  2. Vanda NVIDIA GPU: OpenMP Target Offload (-mp=gpu)            "
echo "=================================================================="
mpirun -np 1 ./bin/kmeans_omp_gpu -f data/higgs_clean.csv -r results/centroids_serial.txt -g -k 8 -m 50 -t 0.0

#!/bin/bash
#PBS -P personal-nithillen.jayaseelan
#PBS -j oe
#PBS -N kmeans_cpu_benchmarks
#PBS -l walltime=00:45:00
#PBS -l select=1:ncpus=72:mpiprocs=72:ompthreads=1:mem=240gb

cd $PBS_O_WORKDIR || exit 1

echo "=================================================================="
echo "  DSA5208 Project 3: Vanda 72-Core CPU Benchmark Suite            "
echo "  Host Node : $(hostname)                                         "
echo "  Date      : $(date)                                             "
echo "=================================================================="
lscpu | grep -E "Model name|Socket|Thread|NUMA|CPU\(s\):" || true

# Load compiler and MPI modules on Vanda compute node
module load nvhpc-hpcx-cuda12/26.1 2>/dev/null || module load OpenMPI 2>/dev/null || true

mkdir -p bin results data

# 1. Compile CPU executables on Vanda compute node
echo "[Step 1] Compiling Serial, MPI, Standalone OpenMP, and Hybrid MPI+OpenMP..."
g++ -O3 -std=c++17 src/kmeans_serial.cpp -o bin/kmeans_serial
mpicxx -O3 -std=c++17 src/kmeans_mpi.cpp -o bin/kmeans_mpi
mpicxx -O3 -std=c++17 -fopenmp src/kmeans_omp.cpp -o bin/kmeans_omp
g++ -O3 -std=c++17 -fopenmp -DSTANDALONE_OMP src/kmeans_omp.cpp -o bin/kmeans_omp_standalone

# 2. Run automated correctness & SSE validation suite
echo "[Step 2] Running automated correctness & SSE validation test suite..."
python3 scripts/test_correctness.py

# 3. Run Serial Baseline & Complexity Scaling on HIGGS
echo "[Step 3] Running Serial Baseline on full HIGGS dataset..."
./bin/kmeans_serial -f data/higgs_clean.csv -k 8 -m 50 -t 1e-5 -o results/centroids_serial.txt

# 4. Run Pure MPI Strong, Weak & Allreduce Scaling (1, 2, 4, 8, 16, 32, 64 cores)
echo "[Step 4] Running Pure MPI Strong, Weak & Allreduce Scaling on Vanda physical cores..."
python3 scripts/run_mpi_scaling.py --ranks "1,2,4,8,16,32,64"

# 5. Run Hybrid MPI + OpenMP Scaling across 72 cores
echo "[Step 5] Running Hybrid MPI + OpenMP Scaling (up to 72 cores)..."
python3 scripts/run_hybrid_and_gpu_benchmarks.py --vanda

echo "=================================================================="
echo "  Vanda CPU Benchmark Suite Complete! CSVs saved in results/      "
echo "=================================================================="
